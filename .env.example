# Copy to .env for local development: cp .env.example .env
# Values below target the app running on your machine against the compose
# Postgres (host port 5434). Inside Docker Compose, DATABASE_HOST=postgres and
# DATABASE_PORT=5432 are set on the api/worker services instead.

NODE_ENV=development

# api | worker | all
APP_ROLE=all

PORT=3000

DATABASE_HOST=localhost
DATABASE_PORT=5434
DATABASE_NAME=notify_queue
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_POOL_MAX=10

# Leave empty to generate a UUID at startup.
WORKER_ID=
WORKER_CONCURRENCY=10
WORKER_BATCH_SIZE=100
WORKER_POLL_INTERVAL_MS=1000
WORKER_RECOVERY_INTERVAL_MS=30000
# How long shutdown waits for in-flight deliveries before exiting.
WORKER_SHUTDOWN_TIMEOUT_MS=30000

# A claimed job whose worker has not finished it within this many seconds is
# assumed crashed and returned to the queue.
JOB_VISIBILITY_TIMEOUT_SECONDS=300

# Upper bound on one provider call; must be shorter than the visibility timeout.
PROVIDER_TIMEOUT_MS=10000

MAX_RETRIES=5

BASE_RETRY_DELAY_MS=1000
MAX_RETRY_DELAY_MS=60000

# Mock provider: probability of a simulated (retryable) outage, and per-call latency.
# Recipients starting with "invalid" are rejected permanently (-> FAILED).
MOCK_FAILURE_RATE=0.2
MOCK_LATENCY_MS=50

RATE_LIMIT_MAX_NOTIFICATIONS=10
RATE_LIMIT_WINDOW_SECONDS=3600

WEBHOOK_URL=http://localhost:3000/webhooks/mock
